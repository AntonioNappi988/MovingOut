# Maintainer: Antonio Nappi <https://github.com/AntonioNappi988>
pkgname=movout
pkgver=1.0.0
pkgrel=1
pkgdesc="Linux distro-hopping / porting tool: scan packages, services and scripts, generate a self-installing .sh for a new machine"
arch=('any')
url="https://github.com/AntonioNappi988/movingout"
license=('MIT')
depends=('python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "movingout-$pkgver"
  install -d "$pkgdir/usr/lib/movout"
  cp -r movout "$pkgdir/usr/lib/movout/"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/movout" <<'EOF'
#!/usr/bin/env bash
export PYTHONPATH="/usr/lib/movout:${PYTHONPATH:-}"
exec python3 -m movout "$@"
EOF
  install -Dm644 man/movout.1 "$pkgdir/usr/share/man/man1/movout.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
